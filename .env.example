# Variables d'environnement — à définir dans Netlify :
# Site configuration → Environment variables. Ne jamais les committer.

# Envoi des formulaires vers la boîte Google Workspace du studio (SMTP).
# SMTP_PASS = mot de passe d'application Google (double authentification requise).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=site@studiodefacto.ca
SMTP_PASS=
MAIL_FROM=site@studiodefacto.ca
MAIL_TO=contact@studiodefacto.ca

# Page de réservation Google « HORAIRE STUDIO » (vide = pas de bouton d'horaire en ligne).
# Lue au moment du build : redéployer après un changement.
NEXT_PUBLIC_BOOKING_URL=

# Cloudflare Web Analytics (mesure sans témoin). Vide = aucun script.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Lien public de la fiche Google Business (sameAs du balisage Dentist).
NEXT_PUBLIC_GBP_URL=
