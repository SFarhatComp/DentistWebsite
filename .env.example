# Variables d environnement du site Studio Dentaire De Facto
#
# En local  : copier ce fichier vers .env.local et remplir.
# En ligne  : Netlify > Site configuration > Environment variables.
#
# Ne jamais versionner .env.local : il contient des secrets.


# --- Adresse du site -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://studiodefacto.ca


# --- Envoi des courriels de formulaire ------------------------------------
# Sans RESEND_API_KEY, les formulaires sont bien enregistres par Netlify mais
# AUCUN courriel n est envoye. La destination, elle, n est pas une variable :
# elle est fixee dans src/lib/email-templates/destinataire.ts.
RESEND_API_KEY=
NOTIFICATION_FROM=Studio De Facto <notifications@studiodefacto.ca>


# --- Agenda Google (plages de rendez-vous) --------------------------------
# Facultatif. Sans ces trois variables, /api/disponibilites fonctionne quand
# meme : il propose les heures d ouverture sans tenir compte de l agenda, et
# repond source="horaires" pour que l interface le signale.
#
# Avec, il retire les creneaux deja occupes dans l agenda, en temps reel.
# Mise en place : voir docs/agenda-google.md
#
# Le courriel du compte de service, de la forme
#   nom@projet.iam.gserviceaccount.com
GOOGLE_SA_EMAIL=
#
# La cle privee du fichier JSON telecharge, champ "private_key".
# A coller TELLE QUELLE, guillemets compris, avec ses \n litteraux.
GOOGLE_SA_PRIVATE_KEY=
#
# L agenda a consulter.
GOOGLE_CALENDAR_ID=direction@studiodefacto.ca
