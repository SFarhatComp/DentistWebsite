# Variables d environnement du site Studio Dentaire De Facto
#
# En local  : copier ce fichier vers .env.local et remplir.
# En ligne  : Netlify > Site configuration > Environment variables.
#
# Ne jamais versionner .env.local : il contient des secrets.


# --- Adresse du site -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://studiodefacto.ca


# --- Envoi des courriels de formulaire ------------------------------------
# Sans RESEND_API_KEY, les formulaires sont bien enregistres par Netlify mais
# AUCUN courriel n est envoye. La destination, elle, n est pas une variable :
# elle est fixee dans src/lib/email-templates/destinataire.ts.
RESEND_API_KEY=
NOTIFICATION_FROM=Studio De Facto <notifications@studiodefacto.ca>


# --- Prise de rendez-vous en ligne ---------------------------------------
# Le lien du planning de rendez-vous Google, de la forme
#   https://calendar.google.com/calendar/appointments/schedules/AcZssZ...
#
# Tant qu il est vide, la page /rendez-vous affiche le formulaire de demande :
# l equipe rappelle pour fixer l heure. Des qu il est rempli, la page affiche
# le calendrier de reservation, ou le patient choisit lui-meme son creneau.
#
# On accepte aussi bien le lien de partage que le code d integration entier :
# le site en extrait l adresse et y ajoute gv=true si besoin.
#
# Mise en place pas a pas : docs/rendez-vous-google.md
NEXT_PUBLIC_GOOGLE_RDV_URL=
