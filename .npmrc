# Strict engines: refuse to install if Node/npm version doesn't match package.json#engines
engine-strict=true

# Save exact versions when adding new packages (no ^ or ~ prefix)
save-exact=true

# Use the lockfile strictly — `npm ci` requires it, `npm install` updates it
# (we use npm ci in CI, npm install only locally for explicit updates)

# Run audit on install (catches known vulnerabilities)
audit=true
audit-level=moderate

# Loglevel for cleaner output
loglevel=warn
